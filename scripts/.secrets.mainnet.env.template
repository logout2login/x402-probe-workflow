# AEO-OS Mainnet Secrets Template
# ================================
# 複製成 scripts/.secrets.mainnet.env 並填值，然後執行 switch_mainnet.bat
# 注意: 此檔案已加入 .gitignore，絕不提交到 git

# ── 收款錢包地址 (0x...) ──
PAY_TO=0xFILL_IN_YOUR_RECEIVING_WALLET

# ── CDP Facilitator ──
FACILITATOR_URL=https://pay.cdp.coinbase.com/v1
CDP_API_KEY=cdpk_FILL_IN_YOUR_CDP_API_KEY
CDP_PRIVATE_KEY=0xFILL_IN_CDP_SIGNER_PRIVATE_KEY

# ── Self-hosted Facilitator 私鑰 (備用) ──
SELFHOSTED_PRIVATE_KEY=0xFILL_IN_SELFHOSTED_PRIVATE_KEY

# ── Verifier Ed25519 私鑰 ──
VERIFIER_SIGNER_PRIVATE_KEY=FILL_IN_64_HEX_ED25519_PRIVATE_KEY

# ── 內部 Sync 共享密鑰 ──
SYNC_SIGNING_KEY=FILL_IN_ANY_RANDOM_STRING

# ── v1.13: Cursor 簽名 HMAC 密鑰 ──
CURSOR_SECRET=FILL_IN_ANY_RANDOM_STRING

# ── v1.8: Reverify endpoint 共享密鑰 ──
REVERIFY_SECRET=FILL_IN_ANY_RANDOM_STRING

# ── 市集 API Keys (可選) ──
MARKET_BAZAAR_API_KEY=FILL_IN_OR_LEAVE_EMPTY
MARKET_AGENT402_API_KEY=FILL_IN_OR_LEAVE_EMPTY
MARKET_MCP_SO_API_KEY=FILL_IN_OR_LEAVE_EMPTY
MARKET_DATAPPOINT_API_KEY=FILL_IN_OR_LEAVE_EMPTY

# ── Verifier 服務 endpoint ──
VERIFIER_ENDPOINT=https://your-verifier.example.com
