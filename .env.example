# 本地/CI 用的環境變量範本。
# 硬性約束：真實密鑰、錢包地址、CDP API key 永遠不要 commit 到版本控制。
# 本文件只放佔位符，供 `wrangler dev` 與測試腳本讀取。

# Worker / Worker-Client base URL（本地 wrangler dev 時為 http://localhost:8787）
BASE=http://localhost:8787

# 本地測試用 Ed25519 私鑰（hex，32 bytes）
# 從 `npm run gen-keypair` 產生後拷貝。此值僅用於本地/CI 生成 verification.json。
VERIFIER_PRIVATE_KEY_HEX=

# 本地 mock facilitator 模式（0/1）；上線環境不要設為 1
MOCK_FACILITATOR=1

# 測試 Agent 自定義 header
TEST_AGENT_ID=test-agent-001
