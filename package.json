    "publish-package": "tsx scripts/publish-package.ts",
    "publish-static": "tsx scripts/publish-static.ts",
    "sync-queue": "tsx scripts/sync-queue.ts",
    "test:unit": "tsx scripts/test-unit.ts",
    "test:sync": "tsx scripts/test-sync.ts",
    "test:agent": "tsx scripts/test-agent.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute ownsite-aeo --local --file=schema/d1.sql",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
