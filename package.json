{
  "name": "ownsite-aeo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verified-Data-Vending / Agentic-AEO v1.0 — verifier-signed trust certificates sold via x402, verified free before payment.",
  "scripts": {
